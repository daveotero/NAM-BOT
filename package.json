{
  "name": "nam-bot",
  "version": "0.7.0",
  "description": "Neural Amp Modeler Training Manager",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run && node --test build/release-metadata.test.cjs",
    "typecheck": "tsc -p tsconfig.node.json --pretty false && tsc -p tsconfig.web.json --pretty false && tsc -p tsconfig.test.json --pretty false",
    "check": "npm run typecheck && npm test && npm run build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:mac": "npm run build && electron-builder --mac --config electron-builder.yml && node build/verify-macos-node-pty.cjs release",
    "package:win": "npm run build && electron-builder --win --config electron-builder.yml",
    "package:local": "npm run build && electron-builder --win --config electron-builder.yml --config.win.signAndEditExecutable=false",
    "test:desktop-shell": "playwright test --config playwright.desktop.config.ts"
  },
  "build": {
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false
  },
  "keywords": [
    "electron",
    "nam",
    "neural-amp-modeler",
    "audio",
    "machine-learning"
  ],
  "author": "Dave Otero",
  "repository": {
    "type": "git",
    "url": "https://github.com/daveotero/nam-bot.git"
  },
  "homepage": "https://github.com/daveotero/nam-bot#readme",
  "bugs": {
    "url": "https://github.com/daveotero/nam-bot/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.11.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-textarea-code-editor": "^3.1.1",
    "electron-log": "^5.4.4",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "rehype-prism-plus": "^2.0.2",
    "uuid": "^13.0.2",
    "zustand": "^5.0.15"
  }
}
